# 이 파일을 .env로 복사해 채운다. .env는 커밋 금지.

# OpenRouter 키
OPENROUTER_API_KEY=

# 1차 모델
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 폴백 모델. 1차와 다른 회사 모델로 고른다.
# 같은 회사 무료 모델 둘을 쓰면 회사 단위로 막힐 때 둘 다 한꺼번에 죽는다.
# `npm run check:or`를 돌려 지금 쓸 수 있는 모델을 확인한 뒤 채운다.
OPENROUTER_FALLBACK_MODEL=

# 제한시간(밀리초)
OPENROUTER_TIMEOUT_MS=40000
OPENROUTER_FALLBACK_TIMEOUT_MS=50000

# 모델에 보낼 최대 글자수
MAX_CHARS=40000
